---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
interface Props {
  showGotoTop?: boolean;
  id?: string;
}
const { showGotoTop = true, id } = Astro.props;
---

<footer
  id={id}
  class="relative bottom-0 left-0 right-0 py-10 mt-20 flex flex-col gap-4 md:justify-center"
>
  <div class=`${showGotoTop ? "block" : "hidden"}`>
    <Button
      variant="ghost"
      className="w-[150%] flex items-center justify-center"
      size="icon"
      asChild
    >
      <a href="#top" aria-label="Topo" class="absolute max-[550px]:bottom-full sm:bottom-[80%] right-[10%] text-secondary dark:text-primary">
        <Icon name={"mdi:arrow-top"} /> Topo
      </a>
    </Button>
  </div>
  <div class="flex flex-col items-center justify-center">
    <div class="flex gap-4 mt-3">
      <Button className="hover:cursor-pointer" variant={"outline"} asChild>
        <a href="https://github.com/" aria-label="GitHub">
          <Icon name="mdi:github" />
        </a>
      </Button>
      <Button className="hover:cursor-pointer" variant={"outline"} asChild>
        <a href="https://linkedin.com/" aria-label="LinkedIn">
          <Icon name="mdi:linkedin" />
        </a>
      </Button>
      <Button className="hover:cursor-pointer" variant={"outline"} asChild>
        <a href="https://instagram.com/" aria-label="Instagram">
          <Icon name="mdi:instagram" />
        </a>
      </Button>
      <Button className="hover:cursor-pointer" variant={"outline"} asChild>
        <a href="https://twitter.com/" aria-label="Twitter">
          <Icon name="mdi:twitter" />
        </a>
      </Button>
      <Button className="hover:cursor-pointer" variant={"outline"} asChild>
        <a href="mailto:matheus_santos_evangelista@hotmail.com" aria-label="E-mail">
          <Icon name="mdi:mail" />
        </a>
      </Button>
    </div>
  </div>
  <div class="text-center text-xs text-secondary dark:text-primary mt-10">
    © 2025 Matheus Evangelista. Todos os direitos reservados.
  </div>
</footer>
